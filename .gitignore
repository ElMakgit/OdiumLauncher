# Build output and runtime data: never part of the source tree.
/target/
/launcher_data/
**/launcher_data/
/dist/
**/dist/

# Pack workspace (generated by tools/Publish-Pack.ps1 or the publisher UI).
# It holds large jars and player ZIPs and is never part of the source tree.
/pack/

# Crash dumps, symbols and logs.
*.pdb
*.log
