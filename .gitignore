# Build output and runtime data: never part of the source tree.
/target/
/launcher_data/
**/launcher_data/
/dist/
**/dist/

# Pack build output (generated by tools/Publish-Pack.ps1 or the publisher UI).
pack/*/OdiumLauncher-*.zip
pack/*/manifest.local.json

# Crash dumps, symbols and logs.
*.pdb
*.log
